<button class="to-top" id="to-top" type="button" aria-label="Наверх"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg></button>
<div class="toast" id="toast">Скопировано</div>

<script>
/* =========================================================
   НАСТРОЙКИ САЙТА — меняйте только этот блок
   ========================================================= */
const CONFIG = {
  name:      'Саня Иванов',
  vk:        'https://vk.ru/bibibi_boba',
  goal:      300000,   // цель сбора, ₽
  raised:    0,        // сколько собрано, ₽ (обновляйте вручную)
  supporters:0,        // сколько людей поддержали
  siteUrl:   '',       // адрес сайта после публикации (для кнопки «Поделиться»)
  requisites: {        // заполните, когда решите публикации реквизиты
    card: '',          // пример: '2200 0000 0000 0000'
    sbp:  ''           // пример: '+7 900 000-00-00'
  }
};
/* ========================================================= */

const fmt = n => new Intl.NumberFormat('ru-RU').format(n) + ' \u20BD';

// подстановка значений из CONFIG
document.getElementById('hero-goal').textContent = fmt(CONFIG.goal);
document.getElementById('stat-goal').textContent = fmt(CONFIG.goal);
document.getElementById('goal-inline').textContent = fmt(CONFIG.goal);
document.getElementById('stat-raised').textContent = fmt(CONFIG.raised);
document.getElementById('raised-inline').textContent = fmt(CONFIG.raised);
document.getElementById('stat-supporters').textContent = CONFIG.supporters > 0 ? new Intl.NumberFormat('ru-RU').format(CONFIG.supporters) : '0';
if (CONFIG.raised > 0) document.getElementById('stat-raised-hint').style.display = 'none';
['hero-vk','step-vk','footer-vk'].forEach(id => document.getElementById(id).href = CONFIG.vk);

// реквизиты (если заполнены)
const req = CONFIG.requisites;
if (req.card || req.sbp) {
  const box = document.getElementById('requisites');
  box.innerHTML = '';
  const rows = [];
  if (req.card) rows.push(['Карта', req.card]);
  if (req.sbp)  rows.push(['СБП / телефон', req.sbp]);
  rows.forEach(([label, value]) => {
    const row = document.createElement('div');
    row.className = 'req-row';
    row.innerHTML = '<div><div class="label"></div><div class="value"></div></div>';
    row.querySelector('.label').textContent = label;
    row.querySelector('.value').textContent = value;
    const btn = document.createElement('button');
    btn.className = 'copy-btn'; btn.type = 'button'; btn.textContent = 'Копировать';
    btn.addEventListener('click', () => copyText(value.replace(/\s/g,''), 'Реквизиты скопированы'));
    row.appendChild(btn);
    box.appendChild(row);
  });
}

// шаринг и копирование ссылки
const pageUrl = CONFIG.siteUrl || (location.protocol.startsWith('http') ? location.href : CONFIG.vk);
document.getElementById('share-vk').href = 'https://vk.com/share.php?url=' + encodeURIComponent(pageUrl);
document.getElementById('copy-link').addEventListener('click', () => copyText(pageUrl, 'Ссылка скопирована'));

async function copyText(text, msg) {
  try { await navigator.clipboard.writeText(text); }
  catch (e) {
    const ta = document.createElement('textarea');
    ta.value = text; document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); } catch (_) {}
    ta.remove();
  }
  const t = document.getElementById('toast');
  t.textContent = msg || 'Скопировано';
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2200);
}

// появление секций при скролле
const io = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
}, { threshold: 0.15 });
document.querySelectorAll('.reveal').forEach(el => io.observe(el));

// анимация прогресс-бара и процентов
const pct = Math.min(100, CONFIG.goal > 0 ? (CONFIG.raised / CONFIG.goal) * 100 : 0);
const barSection = document.getElementById('progress');
const barIO = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (!e.isIntersecting) return;
    barIO.unobserve(e.target);
    document.getElementById('bar-fill').style.width = Math.max(pct, CONFIG.raised > 0 ? 2 : 0) + '%';
    const pctEl = document.getElementById('progress-pct');
    const start = performance.now();
    const dur = 1600;
    (function tick(now) {
      const k = Math.min(1, (now - start) / dur);
      const eased = 1 - Math.pow(1 - k, 3);
      pctEl.textContent = (pct * eased).toFixed(pct > 0 && pct < 1 ? 1 : 0) + '%';
      if (k < 1) requestAnimationFrame(tick);
    })(start);
  });
}, { threshold: 0.4 });
barIO.observe(barSection);

// 3D-наклон фото («5D»-эффект)
const frame = document.querySelector('[data-tilt]');
const fine = matchMedia('(pointer:fine)').matches;
const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
if (frame && fine && !reduced) {
  const wrap = frame.closest('.photo-wrap');
  wrap.addEventListener('mousemove', e => {
    const r = wrap.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width - 0.5;
    const y = (e.clientY - r.top) / r.height - 0.5;
    frame.style.transform = 'rotateX(' + (-y * 7).toFixed(2) + 'deg) rotateY(' + (x * 9).toFixed(2) + 'deg) translateZ(6px)';
  });
  wrap.addEventListener('mouseleave', () => { frame.style.transform = 'rotateX(0deg) rotateY(0deg)'; });
}

// прогресс чтения страницы + кнопка «наверх»
const spBar = document.getElementById('scroll-progress');
const toTop = document.getElementById('to-top');
let scrollTick = false;
function onScroll(){
  const h = document.documentElement;
  const max = h.scrollHeight - window.innerHeight;
  spBar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
  toTop.classList.toggle('show', h.scrollTop > 600);
  scrollTick = false;
}
window.addEventListener('scroll', () => { if (!scrollTick) { scrollTick = true; requestAnimationFrame(onScroll); } }, { passive: true });
onScroll();
toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' }));

// мобильное меню
const burger = document.getElementById('burger');
const mmenu = document.getElementById('mobile-menu');
burger.addEventListener('click', () => {
  const open = mmenu.classList.toggle('open');
  burger.classList.toggle('open', open);
  burger.setAttribute('aria-expanded', open);
});
mmenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
  mmenu.classList.remove('open'); burger.classList.remove('open'); burger.setAttribute('aria-expanded', 'false');
}));

// световое пятно за курсором на карточках
document.querySelectorAll('.dx,.need,.step,.stat').forEach(el => {
  el.classList.add('hover-glow');
  el.addEventListener('pointermove', e => {
    const r = el.getBoundingClientRect();
    el.style.setProperty('--mx', (e.clientX - r.left) + 'px');
    el.style.setProperty('--my', (e.clientY - r.top) + 'px');
  });
});

// анимированные счётчики в плашках статистики
function countUp(el, target, suffix){
  const dur = 1500, start = performance.now();
  (function tick(now){
    const k = Math.min(1, (now - start) / dur);
    const eased = 1 - Math.pow(1 - k, 3);
    el.textContent = new Intl.NumberFormat('ru-RU').format(Math.round(target * eased)) + suffix;
    if (k < 1) requestAnimationFrame(tick);
  })(start);
}
const statsBox = document.querySelector('.stats');
if (statsBox && !reduced) {
  const cio = new IntersectionObserver(es => es.forEach(e => {
    if (!e.isIntersecting) return;
    cio.unobserve(e.target);
    countUp(document.getElementById('stat-goal'), CONFIG.goal, ' ₽');
    countUp(document.getElementById('stat-raised'), CONFIG.raised, ' ₽');
    countUp(document.getElementById('stat-supporters'), CONFIG.supporters, '');
  }), { threshold: 0.4 });
  cio.observe(statsBox);
}
</script>
